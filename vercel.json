{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "installCommand": "uv pip install --system -r requirements.txt",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "backend/**"
    }
  }
}
